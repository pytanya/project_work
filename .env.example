# ==============================================================================
# EduTutor — конфигурация окружения (.env)
# Источник истины: раздел 14 SPECIFICATION.md. Не редактируйте вразнобой.
# Скопируйте в .env и заполните пустые значения (API-ключи).
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ==============================================================================

# === API-ключи и провайдеры LLM ===
# RouterAI — основной провайдер, работает в РФ без VPN (в т.ч. судья Gemini).
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# OpenRouter — заблокирован в РФ (только под VPN); fallback для ролей тьютора/эксперта.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Приоритетный провайдер: routerai | openrouter
LLM_PRIMARY_PROVIDER=routerai

# === Роли моделей ===
# Тьютор: основная модель генерации вопросов/объяснений
TUTOR_MODEL=qwen/qwen3.7-flash
# Эксперт: сложные объяснения (deep dive) и финальная оценка ответа
EXPERT_MODEL=deepseek/deepseek-v4-flash
# Судья (LLM-as-Judge): Gemini на RouterAI — без VPN (противоречие К-1 устранено)
JUDGE_MODEL=google/gemini-3.5-flash-lite
# Fallback-модели судьи (через запятую); Gemini, чтобы bias не вернулся
JUDGE_FALLBACK_MODELS=google/gemini-3.1-flash-lite
# Fallback-модели по провайдеру (через запятую) — для случая 403/недоступности модели.
# Единое имя deepseek/deepseek-v4-flash-0731 — как в клоне research_guard_agent (Ж-2).
FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731,qwen/qwen3.7-flash
# Дешёвая роль: суммаризация/рерайтинг/простые вопросы/пре-оценка (подтверждена RouterAI, 200)
CHEAP_MODEL=google/gemma-3-4b-it
# Fallback дешёвой роли (обычно TUTOR_MODEL)
CHEAP_FALLBACK_MODEL=qwen/qwen3.7-flash
# Порог отказа дешёвой роли, сек (В-2)
CHEAP_TIMEOUT_SEC=30

# === Yandex GPT (ОПЦИОНАЛЬНО; ОТДЕЛЬНЫЙ ключ, НЕ поисковый!) ===
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite

# === Лимиты и бюджеты (В-7) ===
# Страховка от зацикливания графа: максимум LLM-вызовов за сессию (В-6)
MAX_LLM_CALLS_PER_SESSION=90
# Суммарный бюджет сессии, USD
MAX_COST_USD=1.0
# Бюджеты по ролям, USD
CHEAP_ALLOWANCE_USD=0.3                 # дешёвые/локальные роли
TUTOR_ALLOWANCE_USD=0.5                 # тьютор + эксперт
JUDGE_ALLOWANCE_USD=0.5                 # судья (В-5: контракты «вопрос/объяснение» — в офлайн-evals)
# Потолок num_questions (по умолчанию 10)
MAX_QUESTIONS_PER_SESSION=15
# Лимит уточняющих итераций intake
# ВНИМАНИЕ: чек-лист = 5-6 вопросов, лимит 3 исчерпывается на 4-м ответе и ломает
# полный intake (дефект спеки). Прагматично: 8 (чек-лист + запас на уточнения);
# экстренный старт по «не знаю» управляется streak'ом (В-3).
MAX_INTAKE_ITERATIONS=8
# Бюджет времени сессии, сек (важно при медленных вызовах/поиске до 300с)
SESSION_TIME_BUDGET_SEC=900
REQUEST_TIMEOUT=30
# Отдельный увеличенный таймаут RouterAI, сек (primary отвечает медленнее)
ROUTERAI_TIMEOUT=120

# === RAG / embeddings ===
# Основной embedding — многоязычный, качественный русский (В-1);
# обязателен замер retrieval на русском golden set (критерий приёмки, Этап 2)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Провайдер эмбеддингов: api (RouterAI embeddings — без локального torch/VC++) | local (sentence-transformers)
EMBEDDING_PROVIDER=api
# Модель эмбеддингов для API-провайдера (RouterAI); семейство e5 — как в спецификации
EMBEDDING_API_MODEL=intfloat/multilingual-e5-large
# Ollama (ОПЦИОНАЛЬНО; по умолчанию не нужен — дешёвые роли через API RouterAI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHEAP_MODEL=qwen2.5:3b
# --- Хранилище ---
CHROMA_PERSIST_DIR=./data/chroma        # персистентная БД ChromaDB
SOURCES_CACHE_DIR=./data/sources_cache  # кэш скачанных файлов/HTML
CHECKPOINT_DB=./data/checkpoints.db     # AsyncSqliteSaver (LangGraph) (В-4)

# === Поисковые движки ===
# Yandex Search API — ключ только для ПОИСКА (не для Yandex GPT)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Tavily — заблокирован в РФ (только под VPN); опциональный fallback
TAVILY_API_KEY=
# Поисковик по умолчанию: yandex | tavily (DDGS — всегда универсальный fallback)
SEARCH_PRIMARY=yandex

# === Craw4ai / парсинг ===
# robots.txt не обходим НИКОГДА (К-2)
CRAWL4AI_RESPECT_ROBOTS=true
# Пауза между запросами, сек
CRAWL_RATE_LIMIT_SEC=1.5
# Лимит страниц на сессию
MAX_CRAWL_PAGES=20
# Общий лимит на сбор материалов, сек
MAX_TEXTBOOK_SEARCH_SEC=300
# Источники Plan A (В-2): локальные PDF из Downloads, Викиучебник, открытые коллекции,
# поиск Tavily/Yandex по открытым сайтам; РЭШ/НЭБ имеют антибот-защиты — капчу НЕ обходим,
# при блокировке переходим на другие источники Plan A (К-2, раздел 6).
TEXTBOOK_CATALOGS=ru.wikibooks.org,resh.edu.ru,rusneb.ru
# Playwright (dynamic rendering) — для crawl_page_js (раздел 6.1), без обхода защит (К-2).
# ОБЯЗАТЕЛЕН: python -m playwright install chromium (В-3, раздел 11.1)
CRAWL4AI_PLAYWRIGHT_ENABLED=true
CRAWL4AI_PLAYWRIGHT_HEADLESS=true
CRAWL4AI_PLAYWRIGHT_TIMEOUT_MS=30000    # таймаут JS-рендеринга страницы, мс
# Лимит исходного HTML для fetch_html, символов (В-10; сверьте с 6.1)
MAX_FETCH_CHARS_HTML=80000
# Лимит очищенного текста fetch_url, символов (достаточно для генерации вопросов, К-3)
MAX_FETCH_CHARS=32000

# === Сверка с ФГОС (grade_curriculum, В-8) ===
# Офлайн-база ФГОС (YAML/JSON): маппинг «тема/раздел учебника → код/раздел ФГОС»;
# дополняется через crawl4ai из открытых источников Plan A; при недоступности — «не проверено по ФГОС»
FGOS_REFERENCE_DIR=./data/fgos_reference
# Каталог локальных PDF-учебников из Downloads (Plan A/B, В-2)
TEXTBOOKS_DOWNLOADS_DIR=./downloads

# === Трассировка (Phoenix) ===
# true — локальный Phoenix (http://localhost:6006) и трассировка LLM
PHOENIX_ENABLED=true
# Имя проекта в Phoenix (группировка трейсов)
PHOENIX_PROJECT_NAME=edututor

# === API (FastAPI) ===
API_HOST=0.0.0.0
API_PORT=8000
