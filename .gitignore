# --- Секреты и конфигурация ---
# ВАЖНО: .env содержит реальные API-ключи (RouterAI, OpenRouter, Yandex) — НИКОГДА не коммитить!
.env
.env.local
!.env.example

# --- Виртуальное окружение ---
.venv/
venv/
env/

