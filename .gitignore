# --- Секреты и конфигурация ---
# ВАЖНО: .env содержит реальные API-ключи (RouterAI, OpenRouter, Yandex) — НИКОГДА не коммитить!
.env
!.env.example

# --- Виртуальное окружение ---
.venv/
venv/
env/

# --- Кэш Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Результаты прогонов ---
logs/
output/
evals/results_*.json
evals/report_*.md
evals/lesson_eval_*.json

# --- Локальные данные ---
data/*
# Офлайн-база ФГОС (В-8) — часть репозитория (остальное data/* игнорируется)
!data/fgos_reference/
!data/fgos_reference/**
.phoenix_local/
*.db

# --- Черновики / заметки ---
tmp/

# --- Временные артефакты и логи (не коммитить) ---
*.log
tmp_patch*.py
fix_ui.py
None
_tmp_gh/
_gh/
*.PNG
*.png
.roo/
.roomodes
node_modules/
frontend/node_modules/
frontend/dist/
.playwright-cli/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
Thumbs.db
.DS_Store

# --- Кэш pytest ---
.pytest_cache/

# --- Временные артефакты тест-колла ---
# Результаты Этапа 0 (доступность моделей) коммитятся в репозиторий — каталог evals/.
model_probe_results*.json
!evals/model_probe_results*.json
